# Copy this file to ".env" and fill in your keys.
# Every service switches ON when its key is here. An empty key = that service is simulated.
# Check which services are real:  python main.py --check
# Other settings have good defaults (README, "Settings").

# ---------- AI images and video clips (Creator): MachGen ----------
# Get it: https://www.machgen.ai -> Profile -> API Keys (looks like MGA_xxxx:yyyy)
MACHGEN_API_KEY=
# 0 = no AI video clips (saves money): reels become a slideshow of AI images.
AI_VIDEO_ENABLED=1

# ---------- Voiceover (Creator): Fish Audio, free model ----------
# Get it: https://fish.audio -> API Keys
FISH_API_KEY=
# The voice: a Fish voice reference_id (pick one on fish.audio and copy its ID).
FISH_VOICE_ID=d8f13232599c4f60b5df3232ddededca

# ---------- Caption timing (Creator): Whisper on Groq, free ----------
# Get it: https://console.groq.com/keys . Empty = timings estimated from the voice length.
GROQ_API_KEY=

# ---------- Instagram and Facebook (Meta Graph API) ----------
# Instagram: a professional account + a Meta app with "Instagram API with Instagram Login".
# The token lasts 60 days: renew it before it ends.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Facebook: a Page, and a Page access token from the same Meta app.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# ---------- X (Twitter), paid API ----------
# developer.x.com -> your app -> Keys and tokens. App permissions "Read and write".
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ---------- LinkedIn ----------
# OAuth access token (lasts 60 days). Who posts: urn:li:person:<id> (profile) or urn:li:organization:<id> (page).
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# Many businesses: add _<BUSINESS NAME IN CAPITALS, - becomes _> to any platform key, for example:
# INSTAGRAM_ACCESS_TOKEN_SWEET_CRUMBS=

# ---------- Media storage: Cloudflare R2 (needed to post on Instagram and Facebook) ----------
# Private bucket. API token with "Object Read & Write" on this bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 1 = keep each post's images and final files in R2. Set it ON THE GROK BOT ONLY.
MEDIA_UPLOAD=

# ---------- Draft previews and alerts: Discord (the default on Grok Bot) ----------
# Discord channel -> Edit -> Integrations -> Webhooks -> New webhook -> Copy URL.
DISCORD_WEBHOOK_URL=

# ---------- Optional: Telegram (approve drafts and test ideas on the phone) ----------
# In Telegram, open @BotFather -> /newbot -> copy the token.
TELEGRAM_BOT_TOKEN=
# Your chat ID: send "hi" to your bot, then run  python main.py --telegram-setup
TELEGRAM_CHAT_ID=

# ---------- Team ----------
# Default time zone (the brand brief can set its own). Example: Asia/Kolkata
TIMEZONE=UTC
# Part of each week's posts that test one new idea. 0 = no tests.
TEST_SHARE=0.3
