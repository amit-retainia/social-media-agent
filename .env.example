# Copy this file to ".env" and fill in your keys.
# Every service switches ON when its key is here. An empty key = that service is simulated.
# Check which services are real:  python main.py --check

# ---------- Text ----------
# No key: the AI agent that runs the steps (Grok Bot) writes all text (scripts, captions, replies).
# MOCK=1: fixed sample text instead (demo and tests).
MOCK=

# ---------- AI images and video clips (Creator): MachGen  <- the default ----------
# Same models as the CB reels pipeline. One key for images AND video.
# Get it: https://www.machgen.ai  -> Profile -> API Keys  (looks like MGA_xxxx:yyyy)
MACHGEN_API_KEY=
MACHGEN_IMAGE_MODEL=Nano-Banana-2
MACHGEN_VIDEO_MODEL=Vidu-Q3-Turbo
# Video height in pixels. The app picks the nearest height the model allows. Vidu Q3 Turbo: 540 (cheaper) or 720.
MACHGEN_VIDEO_HEIGHT=540
# Models list: https://www.machgen.ai/docs/models  (e.g. images: Nano-Banana-Pro, Seedream-5.0-lite;
# video: LTX-2.3-Pro, MiniMax-H3, Seedance-2.0-Fast, Kling-v3, Veo-3.1-Fast)

# Which service to use. auto = MachGen when its key is set, else the other option below.
IMAGE_PROVIDER=auto
VIDEO_PROVIDER=auto
# text = text to video. image = make an AI image of each scene, then animate it (same look as photo posts).
VIDEO_MODE=image
# 0 = no AI video clips (saves money), even with a key.
AI_VIDEO_ENABLED=1
# No AI video: 1 = reels become a slideshow of AI images with a slow zoom (cheap, postable). 0 = simulated.
SLIDESHOW_FALLBACK=1
VIDEO_TIMEOUT_SECONDS=900

# ---------- Other options (optional, only if you do not use MachGen) ----------
# OpenAI images. Get it: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# gpt-image-1 was shut down on 2026-10-23. gpt-image-2 takes custom sizes.
OPENAI_IMAGE_MODEL=gpt-image-2
# low, medium or high (higher = better and dearer)
OPENAI_IMAGE_QUALITY=medium
# Runway video clips. Get it: https://dev.runwayml.com  -> API Keys (starts with key_)
RUNWAYML_API_SECRET=
RUNWAY_VIDEO_MODEL=gen4.5

# ---------- Captions (Creator) ----------
# 1 = burn captions into the video. An .srt file is always saved too.
BURN_IN_CAPTIONS=1
# Optional: path to a .ttf file (your brand font). Empty = a bold system font.
CAPTION_FONT=

# ---------- Voiceover (Creator): Fish Audio ----------
# Get it: https://fish.audio  -> API Keys. Model s2.1-pro-free costs nothing.
FISH_API_KEY=
# The voice: a Fish voice reference_id (pick one on fish.audio and copy its ID).
FISH_VOICE_ID=d8f13232599c4f60b5df3232ddededca
FISH_MODEL=s2.1-pro-free
FISH_SPEED=1.0
# ---------- Word timings (Creator): Whisper on Groq, free tier ----------
# Times from the voice set the scene cuts and caption timing. Empty = estimated from the voice length.
# Get it: https://console.groq.com/keys
GROQ_API_KEY=

# ---------- Social platforms: Instagram and Facebook (Meta Graph API, no paid service) ----------
# Posts, reads and answers comments, and gets views, likes and reach. Empty = simulated (nothing is posted).
# Instagram: a professional account + a Meta app with "Instagram API with Instagram Login" (same as CB Reels).
# The token lasts 60 days: renew it before it ends.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Facebook: a Page, and a Page access token from the same Meta app (Graph API Explorer).
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# ---------- X (Twitter) ----------
# developer.x.com -> your app -> Keys and tokens. App permissions "Read and write". X's API is paid: check the price.
# Media is uploaded from the disk (no R2 needed). Replies on X are not read (that needs X's search API).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ---------- LinkedIn ----------
# A LinkedIn developer app and an OAuth access token (lasts 60 days). LINKEDIN_AUTHOR_URN is who posts:
#   personal profile: urn:li:person:<id>       (product "Share on LinkedIn", scope w_member_social)
#   company page:     urn:li:organization:<id> (product "Community Management API", LinkedIn must approve it,
#                                               scopes w_organization_social, r_organization_social)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# Per business: add _<BUSINESS NAME IN CAPITALS, - becomes _> to any platform key, for example:
# INSTAGRAM_ACCESS_TOKEN_SWEET_CRUMBS=
# LINKEDIN_AUTHOR_URN_SWEET_CRUMBS=

# ---------- Media storage: Cloudflare R2 (needed to post on Instagram and Facebook) ----------
# Instagram and Facebook download each post's media from an R2 link.
# Private bucket. API token with "Object Read & Write" on this bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional public URL of the bucket (custom domain). Empty = 7-day signed links.
R2_PUBLIC_BASE_URL=
# 1 = keep each post's paid images and final files in R2 (sms/<business>/...). Set it ON THE GROK BOT ONLY.
MEDIA_UPLOAD=

# ---------- Draft previews and alerts: Discord (the default on Grok Bot) ----------
# Each draft (image or video + text) and each alert is posted in a Discord channel.
# The owner approves or asks for changes in the Grok Bot chat.
# Get it: Discord channel -> Edit -> Integrations -> Webhooks -> New webhook -> Copy URL.
DISCORD_WEBHOOK_URL=

# ---------- Optional, on a normal computer only: Telegram bot (approve on the phone) ----------
# You get each draft on your phone (image or video + text) with two buttons: Approve / Ask for changes.
# Alerts (failed posts, hard comments, reminders) come here too. Empty = review in the terminal.
# Get it: in Telegram, open @BotFather -> /newbot -> copy the token.
TELEGRAM_BOT_TOKEN=
# Your chat ID: send "hi" to your new bot, then run  python main.py --telegram-setup
TELEGRAM_CHAT_ID=
# Per business (another owner): TELEGRAM_CHAT_ID_<BUSINESS NAME IN CAPITALS, - becomes _>, for example:
# TELEGRAM_CHAT_ID_SWEET_CRUMBS=
# In the chat, seconds "owner review" waits for your answers on the phone. Later answers: run  python main.py --bot
APPROVAL_WAIT_SECONDS=300
# Remind you this many hours before the post time if a draft is not approved. Past the time, it moves to the next free slot.
APPROVAL_REMINDER_HOURS=2
# python main.py --bot: minutes between Publisher runs.
BOT_PUBLISH_EVERY_MINUTES=5

# ---------- Alerts to the owner (optional) ----------
# Slack or Teams incoming webhook URL.
ALERT_WEBHOOK_URL=
# Email by SMTP (for example Gmail with an app password: smtp.gmail.com, port 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# ---------- Planner ----------
# Default time zone for posting times (the brand brief can set its own). Example: Asia/Kolkata
TIMEZONE=UTC
# Hours between planning and the first possible post (time to make and approve the draft).
PLANNER_MIN_LEAD_HOURS=3

# ---------- Analyst ----------
# Posts seen by fewer people than this are not scored (one lucky share would look huge).
ANALYST_MIN_REACH=100
# Posts per group (for example 3 reels and 3 photo posts) before the Analyst names a "best" format or hour.
ANALYST_MIN_POSTS=3
# Tests (the usual way vs one new idea): part of each week's posts that are test posts. 0 = no tests.
TEST_SHARE=0.3
# Test posts before a decision (1 more if the result is unclear).
TEST_POSTS=2
# Post age at which test posts are judged: 24h (fastest), 3d or 7d (slowest).
TEST_CHECKPOINT=3d
# Weekly report to the owner (follower change, posts, top post), in the business time zone.
REPORT_DAY=Monday
REPORT_HOUR=9

# ---------- Publisher ----------
# Seconds to wait between Publisher retries.
PUBLISH_RETRY_WAIT=2
# Test the "post fails" path (simulated platforms only): 0.0 = never fails, 1.0 = always fails.
SIMULATE_FAIL_RATE=0.0
